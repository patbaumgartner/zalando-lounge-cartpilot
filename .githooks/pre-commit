#!/usr/bin/env sh
set -e

echo "▶ Applying Spring Java Format..."
mvn -q io.spring.javaformat:spring-javaformat-maven-plugin:apply

echo "▶ Sorting pom.xml..."
# Use the sortpom configuration declared in pom.xml (single source of truth).
mvn -q sortpom:sort

echo "▶ Running Taikai architecture checks..."
mvn -q test -Dtest=TaikaiTest -DfailIfNoTests=false

# Re-add any files that were reformatted so the commit includes the fixes
git add -u
